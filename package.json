{
  "name": "saxony-smart-campus",
  "version": "1.0.0",
  "private": true,
  "description": "Saxony Egypt University Smart Campus System — backend, admin, and mobile.",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "husky": "^9.1.6"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.1.1",
      "lodash": "^4.17.23",
      "fast-xml-builder": "^1.1.7",
      "fast-xml-parser": "^4.5.0",
      "js-yaml": "^4.1.1",
      "postcss": "^8.5.10",
      "@tootallnate/once": "^2.0.0"
    }
  }
}
