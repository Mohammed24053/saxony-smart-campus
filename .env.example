# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --- Database ---
DATABASE_URL=postgresql://campus:campus@localhost:5432/smart_campus?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT (RS256) ---
# Generate with: ./scripts/generate-keys.sh
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_REFRESH_SECRET=please-change-me-to-a-64-char-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- QR ---
QR_HMAC_SECRET=please-change-me-to-a-64-char-random-string
QR_DEFAULT_INTERVAL_SECONDS=30

# --- Firebase (FCM) ---
# From Firebase Console → Project Settings → Service Accounts → Generate new key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Newlines must be escaped as \n in .env files
FIREBASE_PRIVATE_KEY=

# --- MinIO (S3-compatible) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=campusminio
MINIO_SECRET_KEY=campusminio
MINIO_BUCKET=smart-campus

# --- Admin bootstrap ---
ADMIN_TOTP_ISSUER=SaxonyEgypt
INITIAL_ADMIN_EMAIL=admin@saxony-egypt.edu
# REQUIRED in production (>= 12 chars). Leave blank locally to have `prisma db seed`
# generate a one-time random password and print it to stdout.
INITIAL_ADMIN_PASSWORD=

# --- Signed cookies (optional, used for any future signed-cookie endpoints) ---
COOKIE_SECRET=

# --- CORS (admin web origin) ---
ADMIN_WEB_ORIGIN=http://localhost:3001

# Used in password-reset emails as the {ADMIN_APP_URL}/reset-password?token=...
ADMIN_APP_URL=http://localhost:3001

# --- SMTP (email) ---
# Leave SMTP_HOST/USER/PASSWORD blank in dev — emails will be logged to stdout instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@saxony-egypt.edu

# --- Sentry (optional) ---
SENTRY_DSN=

# --- Logging ---
LOG_LEVEL=debug
